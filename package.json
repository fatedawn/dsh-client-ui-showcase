{
  "name": "dsh-client-ui-showcase",
  "version": "0.5.0",
  "description": "展示优化：把对话里的代码围栏升级成富组件——内联 SVG/HTML、Mermaid 图表、KaTeX 公式、Artifact 卡片、可折叠推理块、代码块复制与主题美化。Mermaid 已内联，零外链请求。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./engine": {
      "default": "./lib/engine.js"
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.1"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {},
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "plugin",
    "cordis",
    "showcase",
    "render",
    "svg",
    "mermaid",
    "katex",
    "artifact",
    "visualization",
    "offline"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {},
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ]
}
